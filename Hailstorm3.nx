'=================================
' HAILSTORM III: WHERE STORMS BEGIN
' FOLLOWS HAILSTORM II: EYE OF THE
' TEMPEST. FORKED FROM ITS ENGINE
' (ENEMIES AS DATA), WORK IN PROGRESS
'
' MODES (LEFT/RIGHT ON THE TITLE):
' ARCADE; TRAINING (REACH SECTOR 2:
' SLOW BULLETS, NO LIVES LOST, PICK
' A SECTOR WITH UP/DOWN); SECTOR
' SELECT (CLEAR THE GAME); SPECIAL
' (CLEAR WITHOUT CONTINUING: THE
' BOSSES, THEN ONE MORE); MAELSTROM
' (THE TRUE ENDING: FAST BULLETS, NO
' HIDDEN 1UP, KILLS SHOOT BACK)
'
' A   = FORWARD SHOT (NARROW,STRONG)
' B   = SPREAD SHOT (WIDE, WEAK)
' A+B = SHIELD. IT ABSORBS BULLETS,
'   BUT EACH ONE DRAINS IT AND IT
'   SHRINKS AS IT WEAKENS. AT 0% IT
'   SHATTERS. FIRING RECHARGES IT.
' GRAZE: A BULLET PASSING CLOSE (NOT
'   WITH THE SHIELD UP) FILLS THE
'   METER (HUD, RIGHT; 16 GRAZES).
'   FULL, IT FLASHES: A+B THEN GIVES
'   5 S OF OVERDRIVE (FASTER FIRE,
'   DOUBLE POINTS) INSTEAD OF THE
'   SHIELD. GRAZING STRETCHES IT;
'   DYING EMPTIES THE METER.
'
' SCORING: KILLS RAISE THE
' MULTIPLIER (MORE FOR FAST KILLS).
' IT DECAYS QUICKLY, AND EVERY
' ENEMY THAT ESCAPES KNOCKS IT DOWN
'
' SPRITES: 0 HITBOX, 1 SHIP,
' 2 SHIELD, 3-6 BOSS, 7-20 SHOTS,
' 21-32 ENEMIES, 33-63 BULLETS
'
' DATA LIVES IN ROM, NOT IN CODE:
' #3 AREA SCRIPTS, #4 BOSS PATTERNS,
' #5-9 SECTOR CHARACTER BANKS (PACKED),
' #10 BACKDROPS (PACKED). BUILD.PY MAKES
' THEM; SEE IT FOR THE BYTE LAYOUTS
'=================================

GLOBAL PX,PY,SC,HI,LIVES,INV,DEAD,HP,HPMAX,PH,PHT,T,BV,FL
GLOBAL BXO,BYO,GX,GY,NB,NSS,AA
GLOBAL SY1,RA,RB,WL,LHB,GOD,TGR
GLOBAL SHG,SHBRK,SHON,SHSZ,MUL,MMAX,LKT
GLOBAL QL,KIL,TOT,ESC,ONEUP,AREA,PLY,PLON,QUIT,SY0,NEAR
GLOBAL AP,NWT,NTY,NXX,NN,NDT,NDX,AK,TH2,TH3,SECT
GLOBAL P1,P2,P3,RS$,NSP,SNG,MX,MSGT
GLOBAL LE,NRK
GLOBAL BSP,BMAP,BDM,PXL,PXR
GLOBAL MODE,UNL,MXS,SS,DEMO,CNT,BSPD,IL,IR,IU,ID,PANEL,TB
GLOBAL AUTHOR$,EAT
GLOBAL NUS,HITB,GRZ,GRT,MXB,NHID,NFULL,NA,NBX,LCM
GLOBAL SSTG,SW,SHI,SSP,SSN,SSQ,TQN,TQI,GM,ODT,ODM,LGB,OC1,OC2,OC3,ODL
DIM GLOBAL QBX(11),QBY(11),QVX(11),QVY(11),QAX(11),QAY(11),QWA(11),QWS(11),QWF(11),QSP(11),QSC(11),QM(11),QCO(11),TYA(15)
DIM GLOBAL SV(2)

DIM GLOBAL BX(63),BY(63),BDX(63),BDY(63),BA(63),BK(63),BT(63),BAG(63)
DIM GLOBAL ORD(63),YB(63),BCH(63),BAT(63),BCA(63),BH(63),BGZ(63),PB(7),GR2(7)
DIM GLOBAL RCN(127),RCS(127),RCD(127),USD(127),TQ$(5),TQP(5)
DIM GLOBAL TC(7),TZ(7),HS(7),TP(7),TN(7),SR2(7),EXC(2)
DIM GLOBAL SHX(20),SHY(20),SHVX(20),SHVY(20),SHD(20),SHA(20)
DIM GLOBAL QA(11),QX(11),QY(11),QU(11),QV(11),QH(11),QT(11),QG(11)
DIM GLOBAL QB(15),QK(15),QHP(15),QCH(15),SPX(2),SPY(2),SHC(2),SHS(2),SHO(2),SHRT(2)
DIM GLOBAL GA(7),GB(7),TGW(7),PHA(4),PHN(4),PHI(4),ROT(51),MB(4),MN$(4),LT(2)

'BULLET TYPES: CHAR,SIZE,HALF,PAL,
'BULLETS PER SPRITE
'0 SMALL 1 BIG 2 QUAD 3 TRI 4 RING
'5 SPARK, 6 EXPLOSION (HARMLESS),
'7 DRAIN (COSTS THE SHIELD DOUBLE)
FOR I=0 TO 7
  READ TC(I),TZ(I),HS(I),TP(I),TN(I)
NEXT I
DATA 12,0,4,2,1,13,0,4,7,1,32,1,8,2,4
DATA 34,1,8,2,3,64,2,12,7,8,14,0,4,3,0
DATA 36,1,8,4,0,13,0,4,3,2
EXC(0)=36
EXC(1)=38
EXC(2)=40
FOR I=0 TO 7
  PB(I)=128\(2^I)
  'GRAZE RING: 6 PX PAST THE BULLET
  GR2(I)=(HS(I)+6)*(HS(I)+6)
NEXT I

'ENEMY TYPES ARE DATA IN ROM #11
'(SEE BUILD.PY): HEALTH, SCORE AND
'FAST-KILL WINDOW COME FROM THERE
FOR I=0 TO 14
  P=ROM(11)+PEEKW(ROM(11)+1+I*2)
  TYA(I)=P
  QHP(I)=PEEK(P+4)
  QB(I)=PEEK(P+5)*50
  QK(I)=PEEK(P+6)
NEXT I


'SPREAD SHOT: THREE PELLETS
FOR I=0 TO 2
  A=(I-1)*0.45
  SPX(I)=SIN(A)*4.5
  SPY(I)=-COS(A)*4.5
NEXT I

'SHIELD SIZES (SMALL, MID, BIG):
'CHAR, SPRITE SIZE, OFFSET, RADIUS
FOR I=0 TO 2
  READ SHC(I),SHS(I),SHO(I),SHRT(I)
NEXT I
DATA 42,1,0,8,67,2,-4,12,60,3,-8,16

'TITLE LOGO GRADIENT
FOR I=0 TO 7
  READ GA(I),GB(I)
NEXT I
DATA 32,48,48,52,52,56,56,60,60,62,56,60,52,56,48,52

'SET GODDBG=1 FOR AN INVINCIBLE TEST
'RUN, FIRSTAREA=4 TO START AT BOSS
GODDBG=0
FIRSTAREA=1
'RELEASE INFO: THE AUTHOR IS CREDITED
'AFTER THE ENDING
AUTHOR$="JAMES PARROTT"
'MODE NAMES AND THE UNLOCK BIT EACH
'NEEDS (PERSISTENT RAM $E005)
FOR I=0 TO 4
  READ MN$(I),MB(I)
NEXT I
DATA "ARCADE",0,"TRAINING",1,"SECTOR",2
DATA "SPECIAL",4,"MAELSTROM",8
'EACH SECTOR'S BOSS AREA (SECTOR K
'STARTS AT BOA(K-1)+1); 33 IS SPECIAL
'MODE'S EXTRA BOSS
DIM BOA(6)
FOR I=0 TO 6
  READ BOA(I)
NEXT I
'HAILSTORM III SO FAR: STAGE 1 ONLY
DATA 0,5,5,5,5,5,5
SS=1
'STAGES MADE SO FAR
NSTG=1
CALL HSINIT

'THE SHIP'S COLOURS (PALETTE 1), FOR
'WHEN OVERDRIVE'S FLASHING ENDS
OC1=PEEK($FF05)
OC2=PEEK($FF06)
OC3=PEEK($FF07)
ODM=1
GAMEPAD 1
PAUSE OFF
LSNG=-1
MSGT=0
VOLUME 2,5,3
VOLUME 3,10,3

CALL SETUPSTARS
CALL STEPSTARS
ON RASTER CALL RAS

'---------------------------------
TITLE:
STOP
SSTG=0
CALL RESETPLAY
CALL LOADSECTOR(1)
CALL SETUPSTARS
PH=0
TB=(MODE=4)*-1
HI=PEEKL($E010+TB*35)
CALL HUD
BG 0
PAL 7
CALL CTEXT(2,"H A I L S T O R M")
PAL 4
CALL CTEXT(3,"I I I")
PAL 6
CALL CTEXT(4,"WHERE STORMS BEGIN")
PANEL=0
CALL TPANEL(0)
IDLE=0
PALETTE 3,,17,38,56
SPRITE 3 PAL 3 SIZE 2 FLIP 0,0
SPRITE 4 PAL 3 SIZE 2 FLIP 1,0
SPRITE 5 PAL 3 SIZE 2 FLIP 0,0
SPRITE 6 PAL 3 SIZE 2 FLIP 1,0
TGR=1
DO
  CALL STEPSTARS
  INC T
  TGR=T+1
  FOR K=0 TO 7
    J=(K+16+TGR\2) AND 7
    TGW(K)=GA(J)+GB(J)*256
  NEXT K
  IF PANEL=0 THEN
    'ROW 13 SWAPS BETWEEN THE SHIELD AND
    'GRAZING EVERY 2 S
    IF T MOD 120=0 THEN
      BG 0
      PAL 1
      IF T MOD 240=0 THEN CALL CTEXT(13,"     A+B SHIELD     ") ELSE CALL CTEXT(13,"GRAZE, A+B OVERDRIVE")
    END IF
    Y=45+SIN(T*0.04)*1.5
    SPRITE 3,56,Y,112
    SPRITE 4,80,Y,112
    SPRITE 5,56,Y+24,115
    SPRITE 6,80,Y+24,115
  END IF
  'LEFT/RIGHT: MODE. UP/DOWN: SECTOR
  OM=MODE
  IF LEFT TAP(0) THEN CALL NEXTMODE(-1)
  IF RIGHT TAP(0) THEN CALL NEXTMODE(1)
  IF UP TAP(0) THEN ADD SS,1,1 TO MXS
  IF DOWN TAP(0) THEN ADD SS,-1,1 TO MXS
  IF MODE<>OM THEN
    TB=(MODE=4)*-1
    HI=PEEKL($E010+TB*35)
    CALL HUD
    IF PANEL THEN CALL TPANEL(1)
  END IF
  IF T MOD 8=0 THEN
    BG 0
    BG FILL 0,14 TO 19,14 CHAR 0
    M$=MN$(MODE)
    IF MODE=1 OR MODE=2 THEN M$=M$+" "+STR$(SS)
    PAL 6
    CALL CTEXT(14,"< "+M$+" >")
  END IF
  BG 0
  PAL 4
  IF T MOD 60<40 THEN
    CALL CTEXT(15,"PRESS A")
  ELSE
    CALL CTEXT(15,"       ")
  END IF
  'CONTROLS AND HIGH SCORES TAKE TURNS
  IF T MOD 300=0 THEN
    PANEL=1-PANEL
    CALL TPANEL(PANEL)
  END IF
  'ATTRACT MODE AFTER 20 IDLE SECONDS
  IF BUTTON(0) OR UP(0) OR DOWN(0) OR LEFT(0) OR RIGHT(0) THEN IDLE=0 ELSE INC IDLE
  IF IDLE>1200 THEN
    DEMO=-1
    EXIT
  END IF
  IF BUTTON TAP(0,0) THEN EXIT
  WAIT VBL
LOOP
TGR=0
IF DEMO=0 THEN PLAY 2,96,10 SOUND 4

'---------------------------------
GAME:
SC=0
GM=0
SSTG=0
LIVES=3
MUL=1
MMAX=1
ONEUP=0
TKIL=0
TTOT=0
CNT=0
CLR=0
TEND=0
GOD=GODDBG
AREA=FIRSTAREA
IF MODE=1 OR MODE=2 THEN AREA=BOA(SS-1)+1
SPI=1
IF MODE=3 THEN AREA=BOA(1)
BSPD=1
IF MODE=1 THEN BSPD=0.75
IF MODE=4 THEN BSPD=1.3
IF DEMO THEN
  'DEMO: THE START OF A SECTOR ON
  'AUTOPILOT, INVINCIBLE, UNRECORDED
  DMO=MODE
  MODE=0
  BSPD=1
  GOD=1
  DMA=DMA MOD NSTG+1
  AREA=BOA(DMA-1)+1
  DEMOT=0
END IF

STAGE:
CALL RESETPLAY
PH=1
PHT=0
KIL=0
TOT=0
ESC=0
SHG=100
SHBRK=0
PX=72
PY=100
INV=90
DEAD=0
BV=0
FL=0
LKT=0
WV=1
BDRAWN=0
BTM=0
WRN=0
NWT=0
SQN=0
WVT=0
SPRITE 1 PAL 1 SIZE 1
SPRITE 0 PAL 1 PRIO 1
SPRITE 2 PAL 7
FOR I=7 TO 20
  SPRITE I PAL 4 SIZE 0
NEXT I
'AREA RECORD FROM ROM #3: KIND (0 =
'WAVES, ELSE A BOSS ID), PALETTE,
'BACKDROP AND ITS MODE, SONG, SECTOR,
'NAME, SECTOR LINE, LENGTH, THEN THE
'SPAWN ROWS
AP=ROM(3)+PEEKW(ROM(3)+1+(AREA-1)*2)
CALL LOADSECTOR(PEEK(AP+7))
'PROGRESS: THE FURTHEST SECTOR
'REACHED; SECTOR 2 UNLOCKS TRAINING
IF DEMO=0 AND MODE<>1 THEN
  K=MIN(5,SECT)
  IF K>MXS THEN
    MXS=K
    POKE $E006,MXS
  END IF
  IF MXS>1 THEN UNL=UNL OR 1
  POKE $E005,UNL
END IF
AK=PEEK(AP)
P1=PEEK(AP+1)
P2=PEEK(AP+2)
P3=PEEK(AP+3)
BDE=PEEK(AP+4)
BDM=PEEK(AP+5)
SNG=PEEK(AP+6)
AP=AP+8
'MODES 9 TO 11 ARE STORMS
STM=BDM>=9 AND BDM<=11
LFL=0
CALL RSTR
AN$=RS$
CALL RSTR
SL$=RS$
ALEN=PEEKW(AP)
AP=AP+2
'KEEP THE SONG GOING BETWEEN AREAS
'OF A SECTOR
IF MUSIC(3)=0 OR SNG<>LSNG THEN MUSIC SNG
LSNG=SNG
IF AK THEN
  CALL LOADBOSS(AK)
  BXO=56
  BYO=-48
  SPRITE 3 PAL 3 SIZE 2 FLIP 0,0
  SPRITE 4 PAL 3 SIZE 2 FLIP 1,0
  SPRITE 5 PAL 3 SIZE 2 FLIP 0,0
  SPRITE 6 PAL 3 SIZE 2 FLIP 1,0
END IF
PALETTE 3,,P1,P2,P3
CALL HUD
'AREA CARD. BG0 ROW TR SHOWS 48 PX
'DOWN; OVER THE SINKING EARTH THE
'CARD SITS JUST ABOVE IT
TR=6
'MODE 14: BDE IS A STAGE; ITS AREAS
'SHARE ONE SCROLLING MAP, AND THEIR
'CARDS SCROLL PAST ON IT AS SIGNS
IF BDM=14 THEN
  IF BDE<>SSTG THEN CALL STREAMSTART(BDE)
ELSE IF SSTG THEN
  SSTG=0
  BG 0
  CLS 0
END IF
IF BDE AND BDM<>14 THEN
  CALL DRAWBACK(BDE,BDM)
  IF BDM<4 THEN TR=6+PLY\8
  IF BDM=1 THEN TR=3+PLY\8
END IF
BG 0
PAL 3
IF SSTG THEN
  IF AK=0 THEN
    'SIGNS SCROLL IN FROM THE TOP, SO
    'THE BOTTOM LINE GOES FIRST
    IF SL$<>"" THEN CALL SIGN(SL$,4)
    CALL SIGN(AN$,6)
    CALL SIGN("AREA "+STR$(AREA),3)
    MSGT=120
  ELSE
    CALL SIGN("[ "+AN$+" ]",4)
    CALL SIGN("WARNING",4)
    MSGT=150
    WRN=150
  END IF
ELSE IF AK=0 THEN
  CALL CTEXT(TR,"AREA "+STR$(AREA))
  PAL 6
  CALL CTEXT(TR+2,AN$)
  PAL 4
  IF SL$<>"" THEN CALL CTEXT(TR+4,SL$)
  MSGT=120
ELSE
  PAL 4
  CALL CTEXT(TR,"WARNING")
  PAL 6
  CALL CTEXT(TR+2,"HERE COMES")
  PAL 4
  CALL CTEXT(TR+3,"[ "+AN$+" ]")
  MSGT=150
  WRN=150
END IF

DO
  INC T
  CALL STEPSTARS

  '--- PAUSE MENU
  IF PAUSE AND DEMO=0 THEN
    CALL PAUSEMENU
    IF QUIT THEN EXIT
  END IF

  '--- INPUT: A FORWARD, B SPREAD,
  '--- BOTH = SHIELD
  IF DEMO THEN
    'AUTOPILOT: WEAVE UNDER THE BOSS OR
    'ACROSS THE SCREEN, FIRING
    INC DEMOT
    TX=72+SIN(T*0.02)*44
    IF AK THEN TX=GX-8+SIN(T*0.03)*16
    IL=PX>TX+2
    IR=PX<TX-2
    IU=PY>104
    ID=PY<96
    IB=(T\120) MOD 3=0
    IA=NOT IB
    IF BUTTON(0,0) OR BUTTON(0,1) OR DEMOT>1500 THEN EXIT
  ELSE
    IA=BUTTON(0,0)
    IB=BUTTON(0,1)
  END IF
  SHON=0
  'A+B WITH THE METER FULL STARTS
  'OVERDRIVE; THE SHIELD THEN WAITS
  'UNTIL BOTH ARE LET GO (ODL)
  IF IA AND IB THEN
    IF GM>=100 AND ODT=0 AND DEAD=0 AND ODL=0 THEN
      GM=0
      ODT=300
      ODM=2
      ODL=-1
      PLAY 3,84,20 SOUND 4
    END IF
  ELSE
    ODL=0
  END IF
  IF IA AND IB AND DEAD=0 AND SHBRK=0 AND SHG>0 AND ODL=0 THEN SHON=-1

  IF DEAD=0 THEN
    IF SHON THEN CALL SHIPMOVE(1.2) ELSE CALL SHIPMOVE(1.7)
    IF SHON=0 THEN
      IF IA THEN
        IF T MOD (5+2*(ODT>0))=0 THEN
          CALL SHOT(PX+4,PY-6,0,-5,3,10)
          PLAY 2,72,2 SOUND 3
        END IF
      ELSE IF IB THEN
        IF T MOD (7+3*(ODT>0))=0 THEN
          FOR K=0 TO 2
            CALL SHOT(PX+4,PY-2,SPX(K),SPY(K),1,11)
          NEXT K
          PLAY 2,62,2 SOUND 3
        END IF
      END IF
      'FIRING RECHARGES THE SHIELD
      IF IA OR IB THEN
        SHG=MIN(100,SHG+0.12)
        IF SHBRK AND SHG>=30 THEN
          SHBRK=0
          PLAY 3,80,10 SOUND 4
        END IF
      END IF
    END IF
  END IF

  '--- SHIELD SPRITE: SHRINKS AS IT
  '--- WEAKENS, SHIMMERS BY FLIPPING
  IF SHON THEN
    SZ=0
    IF SHG>33 THEN SZ=1
    IF SHG>66 THEN SZ=2
    IF SZ<>SHSZ THEN CALL SETSHIELD(SZ)
    SPRITE 2,PX+SHO(SZ),PY+SHO(SZ),SHC(SZ)
    SPRITE 2 FLIP (T\4) MOD 2,(T\8) MOD 2
  ELSE
    SPRITE OFF 2
  END IF

  '--- PLAYER SHOTS
  CALL MOVESHOTS(-1)

  '--- PARALLAX: BG0 STREAKS OR SURFACE
  IF SSTG THEN
    ADD SW,SSP
    CALL STREAMFEED
  ELSE IF NEAR AND MSGT=0 THEN
    SY0=(SY0-NSP) AND 255
    SCROLL 0,0,SY0
  END IF

  '--- LIGHTNING IN THE STORM SECTOR
  IF STM AND WRN=0 THEN
    IF LFL>0 THEN
      DEC LFL
      PALETTE 0,(LFL MOD 2)*21+2,,,
      IF LFL=0 THEN PALETTE 0,1,,,
    ELSE IF RND<0.005 THEN
      LFL=5
      PLAY 3,4,20 SOUND 7
    END IF
  END IF

  '--- ENEMY BULLETS PULSE SO THEY STAND
  '--- OUT FROM THE BACKGROUND
  IF T MOD 4=0 THEN
    IF T MOD 8=0 THEN
      PALETTE 2,,49,,
      PALETTE 7,,11,,
    ELSE
      PALETTE 2,,54,,
      PALETTE 7,,31,,
    END IF
  END IF

  '--- ENEMY BULLETS (AND THE SHIELD)
  CALL MOVEB

  '--- GRAZE AND OVERDRIVE: 16 GRAZES
  '--- FILL THE METER; FULL, IT WAITS
  '--- FOR A+B: 5 S OF OVERDRIVE (FASTER
  '--- FIRE, DOUBLE POINTS), WHICH MORE
  '--- GRAZES STRETCH
  IF GRZ AND DEAD=0 THEN
    ADD SC,INT(GRZ*10*MUL*ODM)
    IF ODT THEN
      ODT=MIN(300,ODT+GRZ*15)
    ELSE IF GM<100 THEN
      GM=MIN(100,GM+GRZ*6.25)
      IF GM>=100 THEN PLAY 3,76,12 SOUND 4
    END IF
    PLAY 2,92,1 SOUND 8
  END IF
  IF ODT THEN
    DEC ODT
    IF T MOD 4<2 THEN
      PALETTE 1,,63,62,59
    ELSE
      PALETTE 1,,OC1,OC2,OC3
    END IF
    IF ODT=0 THEN CALL ODEND
  ELSE IF GM>0 AND GM<100 THEN
    GM=MAX(0,GM-0.03)
  END IF

  '--- AREA SCRIPT: A SPAWNER WORKS
  '--- THROUGH THE AREA'S DATA
  IF WV=2 THEN
    INC WVT
    IF SQN>0 THEN
      DEC SQC
      IF SQC<=0 THEN
        CALL SPAWN(SQT,SQX,SQI)
        ADD SQX,SQDX
        INC SQI
        DEC SQN
        SQC=SQD
      END IF
    ELSE IF NWT>=0 AND WVT>=NWT THEN
      SQT=NTY
      SQX=NXX
      SQN=NN
      SQD=NDT
      SQDX=NDX
      SQC=0
      SQI=0
      CALL NEXTROW
    END IF
  END IF
  IF WV=2 OR AK>0 THEN CALL MOVEE
  IF WV=2 AND NWT<0 AND SQN=0 AND QL=0 THEN EXIT

  '--- PLANETS: THE EARTH SINKS AWAY,
  '--- THE MOON RISES AND STOPS
  IF PLON=1 AND T MOD 10=0 THEN
    DEC PLY
    SCROLL 0,0,PLY
    IF PLY<16 THEN
      PLON=0
      CALL NEARON
    END IF
  ELSE IF PLON=2 AND MSGT=0 AND T MOD 5=0 THEN
    INC PLY
    SCROLL 0,0,PLY
    IF PLY>=96 THEN PLON=3
  END IF

  '--- BOSS
  IF AK>0 THEN
    IF BDRAWN AND HP>0 THEN CALL BOSSMOVE
    IF BV OR PHT>0 THEN INC BTM
    IF BV AND DEAD=0 THEN CALL BOSSFIRE
    IF PH=1 AND HP<=TH2 THEN
      CALL PHASEUP(2)
    ELSE IF PH=2 AND HP<=TH3 THEN
      CALL PHASEUP(3)
    END IF
    IF PHT>0 THEN
      DEC PHT
      IF PHT=0 THEN BV=-1
    END IF
    IF HP<=0 THEN EXIT
  END IF
  IF FL=2 THEN PALETTE 3,,52,62,63
  IF FL=1 THEN PALETTE 3,,P1,P2,P3
  IF FL>0 THEN DEC FL

  '--- SIREN BEFORE THE BOSS
  IF WRN>0 THEN
    DEC WRN
    IF WRN MOD 30=29 THEN PLAY 3,62,14 SOUND 4
    IF WRN MOD 30<15 AND WRN>0 THEN
      PALETTE 0,16,,,
    ELSE
      PALETTE 0,1,,,
    END IF
  END IF

  '--- PLAYER SPRITES AND COLLISION
  IF DEAD=0 THEN
    CALL DRAWSHIP
    IF INV=0 AND GOD=0 THEN
      'BULLETS ARE CHECKED IN MOVEB (THEIR
      'SPRITES ARE REUSED DOWN THE SCREEN,
      'SO SPRITE HIT CAN'T SEE THEM ALL)
      IF HITB THEN
        CALL PLAYERDIE
      ELSE IF SPRITE HIT(0,21 TO 32) THEN
        CALL PLAYERDIE
      END IF
    END IF
    IF INV>0 THEN DEC INV
  ELSE
    DEC DEAD
    IF DEAD=0 THEN
      IF LIVES<0 THEN
        CALL CONTPROMPT
        IF LIVES<0 THEN EXIT
      END IF
      PX=72
      PY=100
      SHG=100
      SHBRK=0
    END IF
  END IF

  '--- MULTIPLIER DECAYS QUICKLY
  INC LKT
  IF LKT>60 AND MUL>1 THEN MUL=MAX(1,MUL-0.015)

  '--- CARD TEXT, THEN WAVES OR BOSS
  IF MSGT>0 THEN
    DEC MSGT
    IF MSGT=0 THEN
      BG 0
      IF SSTG=0 THEN BG FILL 0,TR TO 19,TR+4 CHAR 0
      IF SSTG THEN
      ELSE IF BMAP THEN
        CALL MAPCOPY
        NEAR=-1
        'HIVE CANYON: A NARROW CORRIDOR
        IF BDM=13 THEN
          PXL=22
          PXR=122
        END IF
      ELSE IF PLON=0 AND BDM<>8 THEN
        CALL NEARON
      END IF
      IF AK=0 THEN
        WV=2
        WVT=0
        SQN=0
        CALL NEXTROW
      ELSE
        BDRAWN=-1
      END IF
    END IF
  END IF

  '--- HUD
  IF T MOD 4=0 THEN
    BG 1
    PAL 6
    NUMBER 0,0,SC,6
    NUMBER 8,0,INT(MUL),1
    NUMBER 10,0,INT(MUL*10) MOD 10,1
    IF SHBRK THEN PAL 3 ELSE PAL 7
    NUMBER 12,0,INT(SHG),3
    'ROW 1: PROGRESS (OR BOSS HEALTH) IN
    'CELLS 0-8, THE GRAZE METER IN 10-19
    '(DRAINING DURING OVERDRIVE)
    IF AK=0 THEN
      HB=0
      IF WV=2 THEN HB=INT(MIN(1,WVT/ALEN)*9)
    ELSE
      HB=INT(HP*9/HPMAX+0.99)
    END IF
    IF HB<>LHB THEN
      LHB=HB
      PAL 6
      IF HB>0 THEN BG FILL 0,1 TO HB-1,1 CHAR 27
      IF HB<9 THEN BG FILL HB,1 TO 8,1 CHAR 28
    END IF
    'A FULL METER FLASHES: READY FOR A+B
    IF ODT THEN GBR=20+INT(ODT/30+0.99) ELSE GBR=INT(GM/10)
    IF GBR=10 AND (T\8) MOD 2 THEN GBR=30
    IF GBR<>LGB THEN
      LGB=GBR
      IF GBR>=20 THEN
        PAL 4
        GBR=GBR-20
      ELSE
        PAL 7
      END IF
      IF GBR>0 THEN BG FILL 10,1 TO 9+GBR,1 CHAR 27
      IF GBR<10 THEN BG FILL 10+GBR,1 TO 19,1 CHAR 28
    END IF
  END IF

  WAIT VBL
LOOP

'---------------------------------
IF DEMO THEN
  DEMO=0
  MODE=DMO
  SC=0
  QUIT=-1
END IF
IF QUIT THEN
  'LET GO OF THE A PRESS THAT CHOSE QUIT
  QUIT=0
  WAIT 10
  GOTO TITLE
END IF
SHON=0
SPRITE OFF 2
ADD TKIL,KIL
ADD TTOT,TOT
IF LIVES<0 THEN
  RES$="GAME OVER"
  GOTO RESULTS
END IF

IF AK=0 THEN
  'AREA CLEAR: THE TALLY. LEFTOVER
  'BULLETS BURST INTO SPARKS, SHOTS
  'FLY ON, AND THE SHIP CAN STILL MOVE
  CALL CANCEL
  NEAR=0
  BG 0
  IF SSTG=0 THEN
    CLS 0
    SCROLL 0,0,0
  END IF
  PLON=0
  DP=100
  IF TOT>0 THEN DP=INT(KIL*100/TOT)
  'AREA BONUSES GROW BY SECTOR
  BONUS=DP*SECT*50
  PERF=(ESC=0) AND (TOT>0)
  IF PERF THEN
    ADD BONUS,5000*SECT
    MUL=MIN(9.9,MUL+1)
  END IF
  ADD SC,BONUS
  IF SSTG THEN
    IF PERF THEN CALL SIGN("PERFECT!",4)
    CALL SIGN("BONUS "+STR$(BONUS),6)
    CALL SIGN("DESTROY "+STR$(DP)+"%",6)
    CALL SIGN("AREA "+STR$(AREA)+" CLEAR",3)
  ELSE
    PAL 3
    CALL CTEXT(3,"AREA "+STR$(AREA)+" CLEAR")
    PAL 6
    TEXT 4,6,"DESTROY"
    NUMBER 12,6,DP,3
    TEXT 15,6,"%"
    TEXT 4,7,"ESCAPED"
    NUMBER 13,7,ESC,2
    TEXT 4,9,"BONUS"
    NUMBER 10,9,BONUS,6
    IF PERF THEN
      PAL 4
      CALL CTEXT(11,"PERFECT!")
    END IF
  END IF
  IF PERF THEN PLAY 2,90,20 SOUND 4
  CALL HUD
  FOR N=0 TO 149
    INC T
    CALL STEPSTARS
    IF SSTG THEN
      ADD SW,SSP
      CALL STREAMFEED
    END IF
    CALL SHIPMOVE(1.7)
    CALL MOVESHOTS(0)
    CALL MOVEB
    CALL DRAWSHIP
    WAIT VBL
  NEXT N
  INC AREA
  GOTO STAGE
END IF

'BOSS DOWN: IT BLOWS UP AROUND ITS
'CENTRE (GX,GY)
BV=0
INV=0
BXO=GX-24
BYO=GY-24
CALL CANCEL
STOP
BTB=MAX(0,90-BTM\60)*1000
FOR N=0 TO 119
  CALL STEPSTARS
  IF N MOD 4=0 THEN
    CALL FIRE(BXO+RND(48),BYO+RND(48),RND*2*PI,0.2,6)
    PLAY 3,10+RND(20),12 SOUND 5
  END IF
  IF N=96 THEN
    'FINAL BLAST: A RING OF FIREBALLS
    FOR J=0 TO 7
      CALL FIRE(BXO+24,BYO+24,J*PI/4,0.9,6)
    NEXT J
    PLAY 3,6,40 SOUND 7
  END IF
  IF N MOD 8<4 THEN
    PALETTE 3,,63,63,63
  ELSE
    PALETTE 3,,P1,P2,P3
  END IF
  CALL MOVEB
  IF SSTG THEN
    ADD SW,SSP
    CALL STREAMFEED
  ELSE IF NEAR THEN
    SY0=(SY0-NSP) AND 255
    SCROLL 0,0,SY0
  END IF
  INC T
  CALL SHIPMOVE(1.7)
  CALL MOVESHOTS(0)
  CALL DRAWSHIP
  IF N=100 THEN
    SPRITE OFF 3 TO 6
    'VICTORY FANFARE
    TRACK 8,0
    TRACK 9,1
  END IF
  WAIT VBL
NEXT N
CALL CLEARB
ADD SC,BTB
NEAR=0
SSTG=0
BG 0
CLS 0
SCROLL 0,0,0
PAL 3
CALL CTEXT(4,AN$+" DOWN")
PAL 6
TEXT 3,7,"TIME BONUS"
NUMBER 14,7,BTB,5
CALL HUD
WAIT 150
IF MODE=1 THEN
  RES$="TRAINING OVER"
  GOTO RESULTS
END IF
'SPECIAL: BOSS AFTER BOSS, THEN THE
'TEMPEST (AREA 33)
IF MODE=3 AND AREA<BOA(6) THEN
  INC SPI
  AREA=BOA(SPI)
  GOTO STAGE
END IF
IF AREA<BOA(5) THEN
  INC AREA
  GOTO STAGE
END IF
CLR=-1
IF MODE=3 THEN
  RES$="SPECIAL CLEAR"
ELSE
  CALL ENDING(1-(TKIL*100>=TTOT*90)-TEND)
  RES$="ALL AREAS CLEAR"
END IF

'---------------------------------
RESULTS:
STOP
SSTG=0
WAIT 30
CALL RESETPLAY
'RANK IN THIS MODE'S TOP 5 (TRAINING
'ISN'T RECORDED; MAELSTROM HAS ITS
'OWN TABLE)
TB=(MODE=4)*-1
RK=5
IF MODE<>1 THEN
  FOR R=4 TO 0 STEP -1
    IF SC>PEEKL($E010+TB*35+R*7) THEN RK=R
  NEXT R
END IF
'UNLOCKS: 1 TRAINING, 2 SECTOR
'SELECT, 4 SPECIAL, 8 MAELSTROM
NL=UNL
IF CLR AND MODE<>3 THEN
  NL=NL OR 2
  IF CNT=0 AND MODE<>2 THEN NL=NL OR 4
  IF TEND THEN NL=NL OR 8
END IF
GAIN=NL AND NOT UNL
UNL=NL
POKE $E005,UNL
PH=0
HI=PEEKL($E010+TB*35)
IF RK=0 THEN HI=SC
CALL HUD
BG 0
PAL 3
CALL CTEXT(3,RES$)
PAL 6
CALL CTEXT(5,"SCORE")
NUMBER 7,6,SC,6
DP=100
IF TTOT>0 THEN DP=INT(TKIL*100/TTOT)
TEXT 3,8,"DESTROY"
NUMBER 12,8,DP,3
TEXT 15,8,"%"
TEXT 3,9,"BEST CHAIN X"
NUMBER 15,9,INT(MMAX),1
TEXT 16,9,"."
NUMBER 17,9,INT(MMAX*10) MOD 10,1
IF CNT THEN
  TEXT 3,10,"CONTINUES"
  NUMBER 15,10,CNT,2
END IF
PAL 4
IF RK=0 THEN
  CALL CTEXT(13,"NEW HIGH SCORE!")
ELSE IF RK<5 THEN
  CALL CTEXT(13,"TOP 5 SCORE!")
END IF
CALL WAITA

IF RK<5 THEN
  'NAME ENTRY: UP/DOWN PICKS A LETTER,
  'A CONFIRMS, B GOES BACK
  BG 0
  CLS 0
  PAL 3
  CALL CTEXT(4,"ENTER YOUR NAME")
  PAL 6
  CALL CTEXT(12,"UP DOWN  LETTER")
  CALL CTEXT(13,"A NEXT  B BACK")
  FOR K=0 TO 2
    LT(K)=65
  NEXT K
  NPOS=0
  DO
    CALL STEPSTARS
    INC T
    IF UP TAP(0) THEN ADD LT(NPOS),1,65 TO 90
    IF DOWN TAP(0) THEN ADD LT(NPOS),-1,65 TO 90
    IF BUTTON TAP(0,1) AND NPOS>0 THEN DEC NPOS
    IF BUTTON TAP(0,0) THEN
      INC NPOS
      PLAY 2,80+NPOS*4,6 SOUND 4
      IF NPOS>2 THEN EXIT
    END IF
    FOR K=0 TO 2
      IF K=NPOS AND T MOD 20<10 THEN PAL 4 ELSE PAL 6
      TEXT 7+K*2,8,CHR$(LT(K))
    NEXT K
    WAIT VBL
  LOOP
  'SHIFT LOWER ENTRIES DOWN, WRITE OURS
  A=$E010+TB*35+RK*7
  IF RK<4 THEN COPY A,(4-RK)*7 TO A+7
  POKEL A,SC
  FOR K=0 TO 2
    POKE A+4+K,LT(K)
  NEXT K
END IF

IF GAIN THEN
  BG 0
  CLS 0
  PAL 3
  CALL CTEXT(4,"UNLOCKED!")
  PAL 6
  FOR K=1 TO 4
    M$=MN$(K)
    IF K=2 THEN M$="SECTOR SELECT"
    IF GAIN AND MB(K) THEN CALL CTEXT(5+K*2,M$)
  NEXT K
  PLAY 2,90,30 SOUND 4
  CALL WAITA
END IF
GOTO TITLE

'=================================
'RUNS BEFORE EVERY SCREEN LINE
SUB RAS
  R=RASTER
  IF R=0 THEN
    'HUD LINES: BG1 ONLY, NO SPRITES OR
    'BG0 (BIT 0 SPRITES, 1 BG0, 2 BG1)
    SCROLL 1,0,0
    POKE $FF20,%100
  ELSE IF R=12 THEN
    SCROLL 1,0,RA
    POKE $FF20,%111
  ELSE IF R=WL THEN
    SCROLL 1,0,RB
  END IF
  'SPRITE REUSE (MOVEB)
  IF RCN(R) THEN COPY RCS(R),RCN(R) TO RCD(R)
  'TITLE LOGO GRADIENT: COLOURS 1-2 OF
  'PALETTE 7 ($FF1D), WORKED OUT PER
  'LINE IN THE TITLE LOOP (TGW)
  IF TGR THEN
    IF R>=16 AND R<24 THEN POKEW $FF1D,TGW(R-16)
  END IF
END SUB

'STARS: BG1 ROWS 2-31 FORM A 240 PX
'RING. THE RASTER SUB SKIPS THE HUD
'ROWS SO THEY NEVER SCROLL INTO VIEW
SUB STEPSTARS
  'STARS DRIFT SLOWER BEHIND A STAGE MAP
  SY1=SY1-2+(SSTG>0)*-1
  IF SY1<0 THEN ADD SY1,240
  IF SY1<228 THEN
    RA=SY1+16
  ELSE
    RA=(SY1+32) AND 255
  END IF
  RB=(SY1+32) AND 255
  WL=240-SY1
  IF WL<=12 THEN WL=-1
END SUB

SUB SETUPSTARS
  BG 1
  CLS 1
  PAL 0
  FOR I=0 TO 70
    CELL RND(19),2+RND(29),29+RND(2)
  NEXT I
END SUB

SUB HUD
  BG 1
  BG FILL 0,0 TO 19,1 CHAR 0
  PAL 6
  NUMBER 0,0,SC,6
  IF PH=0 THEN
    TEXT 11,0,"HI"
    NUMBER 14,0,HI,6
  ELSE
    TEXT 7,0,"X"
    NUMBER 8,0,INT(MUL),1
    TEXT 9,0,"."
    NUMBER 10,0,INT(MUL*10) MOD 10,1
    PAL 7
    NUMBER 12,0,INT(SHG),3
    TEXT 15,0,"%"
    PAL 1
    FOR K=0 TO 2
      IF K<LIVES THEN CELL 17+K,0,26 ELSE CELL 17+K,0,0
    NEXT K
  END IF
  LHB=-1
  LGB=-1
END SUB

SUB CTEXT(ROW,M$)
  TEXT (20-LEN(M$))\2,ROW,M$
END SUB

'OVERDRIVE OVER: SHIP COLOURS BACK
SUB ODEND
  ODT=0
  ODM=1
  PALETTE 1,,OC1,OC2,OC3
END SUB

'A STAGE MAP IN PROGRESS (SSTG) KEEPS
'BG0, ITS SCROLL AND OVERDRIVE
SUB RESETPLAY
  CALL CLEARB
  FOR I=0 TO 11
    QA(I)=0
  NEXT I
  FOR I=7 TO 20
    SHA(I)=0
  NEXT I
  QL=0
  SPRITE OFF
  PLON=0
  NEAR=0
  IF SSTG=0 THEN
    CALL ODEND
    BG 0
    CLS 0
    SCROLL 0,0,0
  END IF
  PALETTE 0,1,,,
  PALETTE 7,,11,47,63
  NB=0
  NBX=64
  NSS=7
  NSP=4
  NRK=0
  BMAP=0
  PXL=0
  PXR=144
  T=0
  SHSZ=-1
END SUB

SUB CLEARB
  FOR I=0 TO 63
    BA(I)=0
    BK(I)=0
  NEXT I
  NA=0
  FOR I=0 TO 127
    RCN(I)=0
  NEXT I
  NUS=0
  FILL $FE84,124,0
END SUB

'BACKDROP E IN BG0. MODE M: 1 A
'PLANET SINKING AWAY, 2 RISING FROM
'BELOW, 3 STILL; THEIR 20X12 MAPS GO
'IN ROWS 18-29. 4 TO 7: A MAP THAT
'LOOPS AS IT SCROLLS, AT M-3 PX A
'FRAME. 8: ONLY LOADED (A BOSS DRAWS
'IT). 10 AND 11: STORM CLOUDS AT 2
'AND 1 PX. (9, RAIN, HAS NO MAP).
'12: THE FLOOR, DRAWN AFTER THE CARD.
'13: CANYON WALLS AT 2 PX. (14 IS A
'STAGE MAP: SEE STREAMSTART)
SUB DRAWBACK(E,M)
  CALL LOADBACK(E)
  BG 0
  IF M=8 OR M=12 THEN EXIT SUB
  IF M<4 THEN
    BG COPY 0,0,20,12 TO 0,18
    PLON=M
    PLY=80
    IF M=2 THEN PLY=16
    IF M=3 THEN PLY=64
    SCROLL 0,0,PLY
  ELSE
    CALL MAPCOPY
    BMAP=-1
    NSP=M-3
    IF M>9 THEN NSP=M-8
    IF M=13 THEN NSP=2
    SY0=0
    SCROLL 0,0,0
  END IF
END SUB

'A LOOPING MAP FILLS BG0'S 32 ROWS;
'A 16-ROW MAP IS DRAWN TWICE
SUB MAPCOPY
  BG 0
  H=PEEK(BSP+3)
  BG COPY 0,0,20,H TO 0,0
  IF H=16 THEN BG COPY 0,0,20,16 TO 0,16
END SUB

'STAGE MAPS (ROM #12, ONE RECORD PER
'STAGE): A BACKDROP HOLDING A LIBRARY
'OF 16-ROW BLOCKS, A SPEED (X4), THEN
'THE BLOCKS IN ORDER (COUNT, IDS).
'THE STAGE SCROLLS THROUGH THEM WHILE
'ITS AREAS COME AND GO; AFTER THE LAST
'BLOCK THE LAST ONE REPEATS (THE BOSS).
'BG0 IS A 32-ROW RING: WORLD ROW R
'(0 AT THE BOTTOM OF THE FIRST
'SCREEN) GOES IN BG ROW -R AND 31. SW
'IS HOW FAR THE STAGE HAS SCROLLED
SUB STREAMSTART(E)
  P=ROM(12)+PEEKW(ROM(12)+1+(E-1)*2)
  CALL LOADBACK(PEEK(P))
  SSP=PEEK(P+1)/4
  SSN=PEEK(P+2)
  SSQ=P+3
  SSTG=E
  SW=0
  SHI=-1
  TQN=0
  TQI=0
  BG 0
  CLS 0
  CALL STREAMFEED
END SUB

'COPY IN EACH ROW UP TO ONE ABOVE THE
'SCREEN (SHI = TOP ROW LOADED). A SIGN
'LINE WAITING (SIGN) IS WRITTEN OVER
'EVERY OTHER NEW ROW, SO TEXT SCROLLS
'PAST WITH THE GROUND
SUB STREAMFEED
  RT=(INT(SW)+135)\8
  IF SHI<RT THEN BG 0
  WHILE SHI<RT
    INC SHI
    K=PEEK(SSQ+MIN(SHI\16,SSN-1))
    D=(32-(SHI AND 31)) AND 31
    BG COPY 0,K*16+15-(SHI AND 15),20,1 TO 0,D
    IF TQI<TQN AND (SHI AND 1)=0 THEN
      PAL TQP(TQI)
      CALL CTEXT(D,TQ$(TQI))
      INC TQI
      IF TQI=TQN THEN
        TQI=0
        TQN=0
      END IF
    END IF
  WEND
  SY0=(-(INT(SW)+120)) AND 255
  SCROLL 0,0,SY0
END SUB

SUB SIGN(M$,P)
  IF TQN<6 THEN
    TQ$(TQN)=M$
    TQP(TQN)=P
    INC TQN
  END IF
END SUB

'NEAR PARALLAX LAYER: SPEED STREAKS
'SCATTERED OVER BG0, WHICH SCROLLS
'TWICE AS FAST AS THE FAR STARS. IT IS
'OFF WHILE BG0 SHOWS TEXT OR THE EARTH
SUB NEARON
  BG 0
  CLS 0
  PAL 0
  N=22
  'DOWNPOUR: DENSER AND FASTER RAIN
  IF BDM=9 THEN
    N=70
    NSP=6
  END IF
  FOR I=0 TO N
    CELL RND(19),RND(31),15+RND(2)
  NEXT I
  NEAR=-1
END SUB

SUB SHIPMOVE(SP)
  IF DEMO=0 THEN
    IL=LEFT(0)
    IR=RIGHT(0)
    IU=UP(0)
    ID=DOWN(0)
  END IF
  IF IL THEN ADD PX,-SP
  IF IR THEN ADD PX,SP
  IF IU THEN ADD PY,-SP
  IF ID THEN ADD PY,SP
  PX=MAX(PXL,MIN(PXR,PX))
  PY=MAX(12,MIN(112,PY))
END SUB

'SHIP FRAME: UPRIGHT OR BANKED (LEFT =
'RIGHT BANK, MIRRORED), FLAME FLICKERS
SUB DRAWSHIP
  FR=(T\3) MOD 2
  IF IL THEN
    SCH=6+FR*2
    SPRITE 1 FLIP 1,0
  ELSE IF IR THEN
    SCH=6+FR*2
    SPRITE 1 FLIP 0,0
  ELSE
    SCH=2+FR*2
    SPRITE 1 FLIP 0,0
  END IF
  IF INV>0 AND INV MOD 6<3 THEN
    SPRITE 1,PX,-32,SCH
    SPRITE 0,PX+4,-32,1
  ELSE
    SPRITE 1,PX,PY,SCH
    SPRITE 0,PX+4,PY+4,1
  END IF
END SUB

'MOVE PLAYER SHOTS; CO=0 SKIPS HITS
SUB MOVESHOTS(CO)
  FOR I=7 TO 20
    IF SHA(I) THEN
      ADD SHX(I),SHVX(I)
      ADD SHY(I),SHVY(I)
      IF SHY(I)<4 OR SHX(I)<-8 OR SHX(I)>160 THEN
        SHA(I)=0
        SPRITE OFF I
      ELSE
        SPRITE I,SHX(I),SHY(I),
        IF CO AND QL>0 THEN
          IF SPRITE HIT(I,21 TO 32) THEN
            E=HIT-21
            IF QA(E) THEN
              SHA(I)=0
              SPRITE OFF I
              CALL HURTE(E,SHD(I))
            END IF
          END IF
        END IF
        IF CO AND SHA(I) AND BV THEN
          IF SPRITE HIT(I,3 TO 6) THEN
            SHA(I)=0
            SPRITE OFF I
            CALL BOSSHIT(SHD(I),HIT)
          END IF
        END IF
      END IF
    END IF
  NEXT I
END SUB

'PLAYER SHOT IN THE NEXT SLOT 7-20
SUB SHOT(X0,Y0,VX,VY,D,C)
  I=NSS
  ADD NSS,1,7 TO 20
  SHA(I)=-1
  SHX(I)=X0
  SHY(I)=Y0
  SHVX(I)=VX
  SHVY(I)=VY
  SHD(I)=D
  SPRITE I,X0,Y0,C
END SUB

SUB SETSHIELD(SZ)
  SHSZ=SZ
  SPRITE 2 SIZE SHS(SZ)
  'ABSORB DISTANCE PER BULLET TYPE
  FOR K=0 TO 7
    R=SHRT(SZ)+HS(K)*0.5
    SR2(K)=R*R
  NEXT K
END SUB

'ENEMY BULLETS: A POOL OF 64 (BK: 0
'BULLET, 2 SPARK, 3 EXPLOSION) DRAWN
'THROUGH THE 31 SPRITES 33-63. ORD
'LISTS THE NA LIVE ONES, KEPT SORTED
'TOP TO BOTTOM BY ONE BUBBLE PASS A
'FRAME (A NEW ONE IS ADDED AT THE END
'AND RISES TO ITS PLACE AT ONCE; DEAD
'ONES ARE DROPPED AS THE LIST IS
'WALKED). RECORD K (4 BYTES
'AT $A000+K*4) USES SPRITE 33+(K MOD
'31): THE FIRST 31 ARE COPIED IN NOW,
'LATER ONES BY THE RASTER ROUTINE ONCE
'THE SLOT'S LAST BULLET HAS BEEN
'DRAWN (RCN/RCS/RCD BY LINE, 3 A
'LINE).
'ONE THAT CAN'T BE REACHED IN TIME IS
'SKIPPED THIS FRAME, AND IS HARMLESS.
'HITS: THE HITBOX PIXEL IS LOOKED UP
'IN THE BULLET'S OWN CHARACTER DATA,
'SO THEY ARE PIXEL-EXACT. GRAZES: A
'BULLET THAT COMES WITHIN GR2 OF THE
'HITBOX COUNTS ONCE (GRZ THIS FRAME)
SUB MOVEB
  CX=PX+8
  CY=PY+8
  KX=PX+7
  KY=PY+7
  '3 COPIES (12 BYTES) A LINE. A NEW
  'RASTER EFFECT THAT FILLS ITS LINES
  'MUST SET LCM=0 AND NBX=31 (NO REUSE)
  LCM=3
  NBX=64
  FOR I=NA-1 TO 1 STEP -1
    IF BY(ORD(I))<BY(ORD(I-1)) THEN
      J=ORD(I)
      ORD(I)=ORD(I-1)
      ORD(I-1)=J
    END IF
  NEXT I
  FOR I=0 TO NUS-1
    RCN(USD(I))=0
  NEXT I
  NUS=0
  K=0
  A=$A000
  LW=-1
  LC=0
  HITB=0
  GRZ=0
  J=0
  NW=0
  'NA CAN GROW INSIDE THE LOOP (A SHIELD
  'BREAKING FIRES AN EXPLOSION)
  WHILE J<NA
    I=ORD(J)
    INC J
    ADD BX(I),BDX(I)
    ADD BY(I),BDY(I)
    Y=INT(BY(I))
    IF BK(I)=3 THEN
      INC BAG(I)
      IF BAG(I)>=15 THEN BA(I)=0 ELSE BCA(I)=EXC(BAG(I)\5)+BAT(I)*256
    ELSE IF Y>130 OR Y<-24 OR BX(I)<-24 OR BX(I)>162 THEN
      BA(I)=0
    ELSE IF NRK THEN
      'ENEMIES FLAGGED 4 (ASTEROIDS) STOP
      'ENEMY BULLETS
      IF BK(I)=0 THEN
        TY=BT(I)
        FOR E=0 TO 11
          IF QA(E) THEN
            IF PEEK(TYA(QT(E))) AND 4 THEN
              C=4+4*(PEEK(TYA(QT(E))) AND 1)
              DX=BX(I)+HS(TY)-QX(E)-C-4
              DY=BY(I)+HS(TY)-QY(E)-C-4
              IF DX*DX+DY*DY<(C+3)*(C+3) THEN BA(I)=0
            END IF
          END IF
        NEXT E
      END IF
    END IF
    IF BA(I) THEN
      POKEW A,BX(I)+32+(Y+32)*256
      POKEW A+2,BCA(I)
      YB(K)=Y+BH(I)
      VIS=-1
      IF K>=31 THEN
        W=MAX(YB(K-31),0)
        IF W<LW THEN W=LW
        'AT MOST LCM COPIES A LINE, SO THE
        'RASTER ROUTINE FITS ITS LINE
        IF W=LW AND (LC=LCM OR K MOD 31=0) THEN W=W+1
        IF W>Y OR W>127 OR LCM=0 THEN
          'TOO LATE: SKIP IT, FREE ITS SLOT
          POKEW A,0
          YB(K)=-24
          VIS=0
          INC NHID
        ELSE IF W=LW THEN
          INC LC
          ADD RCN(W),4
        ELSE
          LW=W
          LC=1
          'COUNT LAST: THE RASTER ROUTINE
          'MAY FIRE BETWEEN THESE LINES
          RCS(W)=A
          RCD(W)=$FE84+(K MOD 31)*4
          RCN(W)=4
          USD(NUS)=W
          INC NUS
        END IF
      END IF
      ORD(NW)=I
      INC NW
      'ONLY BULLETS NEAR THE SHIP CAN HIT,
      'GRAZE OR MEET THE SHIELD
      IF ABS(Y-KY)<36 THEN
       IF BK(I)=0 THEN
        TY=BT(I)
        DY=BY(I)+HS(TY)-CY
        DX=BX(I)+HS(TY)-CX
          D2=DX*DX+DY*DY
          IF SHON THEN
            IF D2<SR2(TY) THEN
              BA(I)=0
              POKEW A,0
              CALL ABSORB(TN(TY))
            END IF
          ELSE IF D2<GR2(TY) THEN
            IF BGZ(I)=0 THEN
              BGZ(I)=-1
              INC GRZ
            END IF
            'HIT: THE HITBOX PIXEL IS INSIDE
            'THIS SPRITE AND SET THERE
            D=KY-Y
            E=KX-INT(BX(I))
            IF VIS AND D>=0 AND D<BH(I) AND E>=0 AND E<BH(I) THEN
              B=$8000+(BCH(I)+(D\8)*16+E\8)*16+(D AND 7)
              IF (PEEK(B) OR PEEK(B+8)) AND PB(E AND 7) THEN HITB=-1
            END IF
          END IF
       END IF
      END IF
      A=A+4
      INC K
    END IF
  WEND
  NA=NW
  N0=MIN(K,31)
  IF N0 THEN COPY $A000,N0*4 TO $FE84
  IF N0<31 THEN FILL $FE84+N0*4,(31-N0)*4,0
  IF K>MXB THEN MXB=K
  ADD GRT,GRZ
END SUB

'THE SHIELD SOAKED UP N BULLETS
SUB ABSORB(N)
  SHG=SHG-4*N
  IF SHG<=0 THEN
    SHG=0
    SHBRK=-1
    SHON=0
    SPRITE OFF 2
    PLAY 3,20,30 SOUND 9
    CALL FIRE(PX+8,PY+8,0,0,6)
  ELSE
    PLAY 2,84,1 SOUND 8
  END IF
END SUB

'PHASE CHANGES TURN BULLETS INTO
'HARMLESS SPARKS
SUB CANCEL
  FOR I=0 TO 63
    IF BA(I) THEN
      IF BK(I)=0 THEN
        BK(I)=2
        ADD BX(I),HS(BT(I))-4
        ADD BY(I),HS(BT(I))-4
        BT(I)=5
        BDX(I)=BDX(I)*0.4
        BDY(I)=BDY(I)*0.4-0.5
        BCH(I)=14
        BAT(I)=4
        BCA(I)=14+4*256
        BH(I)=8
      END IF
    END IF
  NEXT I
END SUB

SUB FIRE(X0,Y0,AN,SPD,TY)
  I=NB
  ADD NB,1,0 TO 63
  IF BA(I) OR NA>=NBX THEN
    INC NFULL
    EXIT SUB
  END IF
  ORD(NA)=I
  INC NA
  BA(I)=-1
  BK(I)=0
  IF TY=5 THEN BK(I)=2
  IF TY=6 THEN
    BK(I)=3
    BAG(I)=0
  END IF
  BT(I)=TY
  BX(I)=X0-HS(TY)
  BY(I)=Y0-HS(TY)
  'TRAINING SLOWS BULLETS, MAELSTROM
  'SPEEDS THEM UP
  BDX(I)=COS(AN)*SPD*BSPD
  BDY(I)=SIN(AN)*SPD*BSPD
  BCH(I)=TC(TY)
  BAT(I)=TP(TY)+TZ(TY)*64
  BCA(I)=BCH(I)+BAT(I)*256
  BH(I)=8+TZ(TY)*8
  BGZ(I)=0
END SUB

SUB AIM(X0,Y0)
  DX=PX+8-X0
  DY=PY+8-Y0
  IF DX=0 THEN DX=0.001
  AA=ATAN(DY/DX)
  IF DX<0 THEN AA=AA+PI
END SUB

'NEW ENEMY IN THE FIRST FREE SLOT,
'SET UP FROM ITS TYPE'S DATA
SUB SPAWN(TY,X0,IX)
  LE=-1
  FOR E=0 TO 11
    IF QA(E)=0 THEN
      LE=E
      QA(E)=-1
      QT(E)=TY
      QG(E)=0
      QH(E)=QHP(TY)
      S=21+E
      INC TOT
      P=TYA(TY)
      FL=PEEK(P)
      SM=PEEK(P+2)
      QM(E)=1
      QBX(E)=X0
      QBY(E)=-16
      QCO(E)=8
      SZ=1
      IF FL AND 1 THEN
        QBY(E)=-24
        QCO(E)=12
        SZ=2
      ELSE IF FL AND 2 THEN
        QCO(E)=4
        SZ=0
      END IF
      IF SM=1 THEN
        QBX(E)=-16
        QBY(E)=ABS(X0)
        IF X0<0 THEN
          QBX(E)=160
          QM(E)=-1
        END IF
      ELSE IF SM=2 THEN
        QBY(E)=24+IX*14
        IF X0>=80 THEN QM(E)=-1
      ELSE IF SM=3 THEN
        QBY(E)=130
      END IF
      QSP(E)=P+8
      CALL LOADSEG(E)
      IF FL AND 32 THEN QVX(E)=(68-X0)/300
      ROT(40+E)=0
      QX(E)=QBX(E)
      QY(E)=QBY(E)
      SPRITE S SIZE SZ FLIP -(QM(E)<0),-((FL AND 64)>0)
      SPRITE S,QX(E),QY(E),QCH(TY)
      EXIT SUB
    END IF
  NEXT E
END SUB

'NEXT MOVEMENT SEGMENT: FRAMES (0 =
'FOREVER, 254 LOOP, 253 BURST AND
'ESCAPE), VELOCITY, ACCELERATION,
'WEAVE, FLAGS
SUB LOADSEG(E)
  P=QSP(E)
  D=PEEK(P)
  IF D=254 THEN
    P=TYA(QT(E))+8+PEEK(P+1)*8
    D=PEEK(P)
  END IF
  IF D=253 THEN
    CALL MINEB(QX(E)+QCO(E),QY(E)+QCO(E))
    QBY(E)=200
    QSC(E)=-1
    EXIT SUB
  END IF
  QSC(E)=D+(D=0)
  SPRITE 21+E PAL PEEK(TYA(QT(E))+1)
  F=PEEK(P+7)
  IF (F AND 8)=0 THEN
    QVX(E)=(PEEK(P+1)-128)/32
    QVY(E)=(PEEK(P+2)-128)/32
  END IF
  QAX(E)=(PEEK(P+3)-128)/500
  QAY(E)=(PEEK(P+4)-128)/500
  QWA(E)=PEEK(P+5)
  QWS(E)=PEEK(P+6)/1000
  QWF(E)=F
  QSP(E)=P+8
END SUB

SUB MOVEE
  QL=0
  NRK=0
  FOR E=0 TO 11
    IF QA(E) THEN
      INC QG(E)
      G=QG(E)
      TY=QT(E)
      'RUN THE TYPE'S MOVEMENT SEGMENT
      IF QSC(E)>0 THEN
        DEC QSC(E)
        IF QSC(E)=0 THEN CALL LOADSEG(E)
      END IF
      F=QWF(E)
      C=QCO(E)
      IF F AND 4 THEN
        'HOMING
        CALL AIM(QX(E)+C,QY(E)+C)
        QVX(E)=QVX(E)*0.92+COS(AA)*0.22
        QVY(E)=QVY(E)*0.92+SIN(AA)*0.22
      END IF
      ADD QVX(E),QAX(E)
      ADD QVY(E),QAY(E)
      ADD QBX(E),QVX(E)*QM(E)
      ADD QBY(E),QVY(E)
      QX(E)=QBX(E)
      QY(E)=QBY(E)
      IF QWA(E) THEN
        W=SIN(G*QWS(E))*QWA(E)
        IF F AND 1 THEN ADD QY(E),W ELSE ADD QX(E),W
      END IF
      IF F AND 2 THEN SPRITE 21+E PAL 3+(G\3) MOD 2
      P=TYA(TY)
      IF PEEK(P) AND 4 THEN INC NRK
      'ATTACK ROWS: FIRE WITHIN THEIR
      'WINDOW, LIKE A BOSS'S ROWS
      N=PEEK(P+7)
      IF N THEN
        GX=QX(E)+C
        GY=QY(E)+C
        MX=QM(E)
        EAT=-1
        P=P+PEEK(P+3)
        FOR R=1 TO N
          IF G>=PEEK(P) AND (G<=PEEK(P+1) OR PEEK(P+1)=255) THEN
            IF (G+PEEK(P+3)) MOD PEEK(P+2)=0 THEN CALL ATTACK(P+2,40+E)
          END IF
          P=P+13
        NEXT R
        EAT=0
        MX=1
      END IF
      'LEFT THE SCREEN ALIVE: ESCAPED
      IF QY(E)>132 OR QY(E)<-30 OR QX(E)<-26 OR QX(E)>170 THEN
        QA(E)=0
        SPRITE OFF 21+E
        INC ESC
        MUL=MAX(1,MUL-1)
        PLAY 3,30,6 SOUND 6
      ELSE
        SPRITE 21+E,QX(E),QY(E),
        INC QL
      END IF
    END IF
  NEXT E
END SUB

SUB HURTE(E,D)
  ADD QH(E),-D
  IF QH(E)<=0 THEN
    QA(E)=0
    SPRITE OFF 21+E
    TY=QT(E)
    C=QCO(E)
    CALL FIRE(QX(E)+C,QY(E)+C,0,0,6)
    FL=PEEK(TYA(TY))
    IF FL AND 8 THEN CALL MINEB(QX(E)+C,QY(E)+C)
    IF FL AND 16 THEN
      'A BIG ASTEROID SPLITS IN TWO
      RX=QX(E)+4
      RY=QY(E)+4
      FOR K=-1 TO 1 STEP 2
        CALL SPAWN(8,RX,0)
        IF LE>=0 THEN
          QBX(LE)=RX
          QBY(LE)=RY
          QVX(LE)=K*0.9
        END IF
      NEXT K
    END IF
    'FAST KILLS RAISE THE MULTIPLIER
    'MORE
    V=0.1
    IF QG(E)<QK(TY) THEN V=0.25
    CALL KILLSCORE(QB(TY),V)
    INC KIL
    PLAY 3,24+RND(6),14 SOUND 5
    'MAELSTROM: EVERY KILL SHOOTS BACK
    IF MODE=4 THEN
      X0=QX(E)+8
      Y0=QY(E)+8
      CALL AIM(X0,Y0)
      CALL FIRE(X0,Y0,AA,1,0)
    END IF
  ELSE
    PLAY 3,50,1 SOUND 6
  END IF
END SUB

'A MINE BURSTS INTO A RING
SUB MINEB(X0,Y0)
  FOR K=0 TO 5
    CALL FIRE(X0,Y0,K*PI/3+0.5,0.9,0)
  NEXT K
  PLAY 3,30,10 SOUND 5
END SUB

SUB KILLSCORE(B,V)
  ADD SC,INT(B*MUL*ODM)
  OLD=INT(MUL)
  MUL=MIN(9.9,MUL+V)
  IF INT(MUL)>OLD THEN PLAY 3,68+INT(MUL)*2,8 SOUND 4
  IF MUL>MMAX THEN MMAX=MUL
  LKT=0
  'HIDDEN 1UP COUNTER (NOT IN
  'MAELSTROM)
  IF MODE<>4 THEN INC ONEUP
  IF ONEUP>=150 THEN
    ONEUP=0
    INC LIVES
    CALL HUD
    PLAY 2,90,30 SOUND 4
  END IF
END SUB

'BOSS: THE LEFT HALF IS SPRITES 3
'AND 5, THE RIGHT HALF THE SAME ART
'FLIPPED (4 AND 6)
SUB BOSSMOVE
  IF BYO<14 THEN
    ADD BYO,0.5
  ELSE IF PHT=0 THEN
    BV=-1
  END IF
  BXO=56+SIN(T*0.019*(1+PH*0.3))*46
  Y=BYO
  IF PH=2 THEN Y=BYO-6+SIN(T*0.05)*3
  SPRITE 3,BXO,Y,112
  SPRITE 4,BXO+24,Y,112
  SPRITE 5,BXO,Y+24,115
  SPRITE 6,BXO+24,Y+24,115
  GX=BXO+24
  GY=Y+24
END SUB

'BOSS ATTACKS ARE ROWS IN ROM #4, 11
'BYTES EACH: PERIOD, OFFSET, SHAPE
'(0 FAN, 1 RING, 2 SPAWN), COUNT,
'STEP X100, SPEED X20, BULLET OR
'ENEMY TYPE, X+64 AND Y+64 FROM THE
'BOSS CENTRE, AIM (0 DOWN, 1 AT THE
'PLAYER, 2 ROTATING, 3 FIXED AT TURN
'FROM DOWN), TURN X100+128. A ROW
'FIRES WHEN (T+OFFSET) MOD PERIOD=0.
SUB BOSSFIRE
  FOR R=0 TO PHN(PH)-1
    P=PHA(PH)+R*11
    IF (T+PEEK(P+1)) MOD PEEK(P)=0 THEN CALL ATTACK(P,PHI(PH)+R)
  NEXT R
END SUB

SUB ATTACK(P,RI)
  N=PEEK(P+3)
  X0=GX+(PEEK(P+7)-64)*MX
  Y0=GY+PEEK(P+8)-64
  SH=PEEK(P+2)
  IF SH=2 THEN
    FOR K=1 TO N
      CALL SPAWN(PEEK(P+6),X0,0)
      IF EAT AND LE>=0 THEN
        QBX(LE)=X0
        QBY(LE)=Y0
      END IF
    NEXT K
    EXIT SUB
  END IF
  AM=PEEK(P+9)
  TU=(PEEK(P+10)-128)/100*MX
  B0=PI/2
  IF AM=1 THEN
    CALL AIM(X0,Y0)
    B0=AA
  ELSE IF AM=2 THEN
    B0=ROT(RI)
  ELSE IF AM=3 THEN
    B0=PI/2-TU
  END IF
  ADD ROT(RI),TU
  'FANS ARE CENTRED ON THE AIM, RINGS
  'GO ALL THE WAY ROUND FROM IT
  ST=PEEK(P+4)/100
  OF=(N-1)/2
  IF SH=1 THEN
    ST=2*PI/N
    OF=0
  END IF
  SPD=PEEK(P+5)/20
  TY=PEEK(P+6)
  IF SH>=3 THEN
    'LANCE: A LINE OF BULLETS STEP PX
    'APART, TRAILING BACK FROM THE GUN.
    'WALL: THE LINE SIDE-ON
    ST=PEEK(P+4)
    CX=-COS(B0)
    CY=-SIN(B0)
    KO=0
    IF SH=4 THEN
      CX=-CY
      CY=COS(B0)
      KO=(N-1)/2
    END IF
    FOR K=0 TO N-1
      CALL FIRE(X0+CX*(K-KO)*ST,Y0+CY*(K-KO)*ST,B0,SPD,TY)
    NEXT K
    PLAY 3,70,6 SOUND 7
    EXIT SUB
  END IF
  FOR K=0 TO N-1
    CALL FIRE(X0,Y0,B0+(K-OF)*ST,SPD,TY)
  NEXT K
END SUB

'BOSS RECORD FROM ROM #4: HP, PHASE
'2 AND 3 THRESHOLDS (2 BYTES EACH),
'PALETTE, THEN PER PHASE A ROW COUNT
'AND ITS ATTACK ROWS
SUB LOADBOSS(B)
  P=ROM(4)+PEEKW(ROM(4)+1+(B-1)*2)
  HP=PEEKW(P)
  HPMAX=HP
  TH2=PEEKW(P+2)
  TH3=PEEKW(P+4)
  P1=PEEK(P+6)
  P2=PEEK(P+7)
  P3=PEEK(P+8)
  P=P+9
  RI=0
  FOR K=1 TO 4
    PHN(K)=PEEK(P)
    PHA(K)=P+1
    PHI(K)=RI
    ADD RI,PHN(K)
    P=P+1+PHN(K)*11
  NEXT K
  FOR K=0 TO 39
    ROT(K)=0
  NEXT K
  MX=1
END SUB

'NEXT SPAWN ROW OF THE AREA SCRIPT:
'FRAME (2 BYTES, -1 ENDS), TYPE,
'X+64, COUNT, GAP, X STEP+128
SUB NEXTROW
  NWT=PEEKW(AP)
  NTY=PEEK(AP+2)
  NXX=PEEK(AP+3)-64
  NN=PEEK(AP+4)
  NDT=PEEK(AP+5)
  NDX=PEEK(AP+6)-128
  AP=AP+7
END SUB

'A LENGTH-PREFIXED STRING AT AP
SUB RSTR
  RS$=""
  N=PEEK(AP)
  FOR K=1 TO N
    RS$=RS$+CHR$(PEEK(AP+K))
  NEXT K
  AP=AP+1+N
END SUB

'LZ UNPACKER (BUILD.PY'S LZ): A 2-BYTE
'LENGTH, THEN OPS: 0-127 LITERAL RUN
'OF N+1 BYTES, 128-191 FILL OF N-125,
'192-255 COPY N-189 BYTES FROM A
'2-BYTE DISTANCE BACK
'WORKING RAM: $A800 SECTOR BANK
'(WHILE LOADING), $B000 BACKDROP
SUB UNPACK(UQS,UQD)
  UQE=UQD+PEEKW(UQS)
  UQS=UQS+2
  WHILE UQD<UQE
    UQC=PEEK(UQS)
    IF UQC<128 THEN
      COPY UQS+1,UQC+1 TO UQD
      UQS=UQS+UQC+2
      UQD=UQD+UQC+1
    ELSE IF UQC<192 THEN
      FILL UQD,UQC-125,PEEK(UQS+1)
      UQS=UQS+2
      UQD=UQD+UQC-125
    ELSE
      COPY UQD-PEEKW(UQS+1),UQC-189 TO UQD
      UQS=UQS+3
      UQD=UQD+UQC-189
    END IF
  WEND
END SUB

'SECTOR ART: 48 CHARACTERS (ENEMIES
'AND BOSS) INTO 112-159
SUB LOADSECTOR(N)
  IF N=SECT THEN EXIT SUB
  SECT=N
  'FIRST THE CHARACTER OF EACH ENEMY
  'TYPE IN THIS SECTOR
  'PACKED IN ROM: UNPACK TO RAM FIRST
  CALL UNPACK(ROM(4+N),$A800)
  A=$A800
  FOR K=0 TO 15
    QCH(K)=PEEK(A+K)
  NEXT K
  COPY A+16,768 TO $8000+112*16
END SUB

'BACKDROP E FROM ROM #10'S TABLE:
'3 COLOURS (PALETTE
'5), TILE COUNT, TILES, THEN A MAP.
'THE TILES FILL THE FREE CHARACTER
'RANGES IN BSLOTS, IN ORDER. PACKED
'IN ROM; UNPACKED TO $B000, WHERE THE
'MAP STAYS AS THE BG SOURCE
SUB LOADBACK(E)
  CALL UNPACK(ROM(10)+PEEKW(ROM(10)+1+(E-1)*2),$B000)
  A=$B000
  PALETTE 5,,PEEK(A),PEEK(A+1),PEEK(A+2)
  N=PEEK(A+3)
  P=A+4
  RESTORE BSLOTS
  WHILE N>0
    READ C0,CN
    M=MIN(CN,N)
    COPY P,M*16 TO $8000+C0*16
    ADD P,M*16
    ADD N,-M
  WEND
  BG SOURCE P
  BSP=P
END SUB
BSLOTS:
DATA 160,32,44,4,70,6,86,6,102,6

'H IS THE BOSS SPRITE THAT WAS HIT.
'A BOSS MADE OF UNITS TAKES DAMAGE ON
'THE UNIT THAT WAS HIT
SUB BOSSHIT(D,H)
  ADD SC,INT(5*D*MUL*ODM)
  FL=2
  IF T MOD 4=0 THEN PLAY 3,40,1 SOUND 6
  ADD HP,-D
END SUB

SUB PHASEUP(P)
  PH=P
  BV=0
  PHT=70
  ADD SC,5000
  CALL CANCEL
  FL=2
  PLAY 3,20,40 SOUND 5
END SUB

SUB PLAYERDIE
  'TRAINING: NO LIVES LOST
  IF MODE<>1 THEN DEC LIVES
  MUL=1
  GM=0
  CALL ODEND
  'DEATHS ALSO FILL THE 1UP COUNTER
  ADD ONEUP,40
  INV=150
  DEAD=45
  SHON=0
  SPRITE OFF 2
  PLAY 3,8,40 SOUND 5
  CALL CLEARB
  CALL FIRE(PX+8,PY+8,0,0,6)
  FOR K=0 TO 7
    CALL FIRE(PX+8,PY+8,K*PI/4,1.1,5)
  NEXT K
  SPRITE OFF 0 TO 1
  CALL HUD
END SUB

'HIGH SCORES IN PERSISTENT RAM:
'$E010+TABLE*35+RANK*7 = SCORE (4
'BYTES) + 3 LETTERS. TABLE 0 ARCADE,
'1 MAELSTROM. $E005 UNLOCKS, $E006 THE
'FURTHEST SECTOR REACHED
SUB HSINIT
  IF PEEK($E004)<>22 THEN
    FOR D=0 TO 1
      FOR R=0 TO 4
        A=$E010+D*35+R*7
        POKEL A,(5-R)*100000
        POKE A+4,74
        POKE A+5,80
        POKE A+6,65
      NEXT R
    NEXT D
    POKE $E005,0
    POKE $E006,1
    POKE $E004,22
  END IF
  UNL=PEEK($E005)
  MXS=PEEK($E006)
END SUB

'TITLE PANEL: 0 CONTROLS (WITH GALE
'KNIGHT), 1 THE MODE'S HIGH SCORES
SUB TPANEL(P)
  BG 0
  BG FILL 0,5 TO 19,13 CHAR 0
  IF P=0 THEN
    PAL 1
    CALL CTEXT(12,"A SHOT  B SPREAD")
    CALL CTEXT(13,"A+B SHIELD")
  ELSE
    SPRITE OFF 3 TO 6
    PAL 3
    IF TB THEN CALL CTEXT(6,"MAELSTROM BEST") ELSE CALL CTEXT(6,"BEST SCORES")
    FOR R=0 TO 4
      A=$E010+TB*35+R*7
      PAL 6
      NUMBER 3,8+R,R+1,1
      TEXT 6,8+R,CHR$(PEEK(A+4))+CHR$(PEEK(A+5))+CHR$(PEEK(A+6))
      NUMBER 11,8+R,PEEKL(A),6
    NEXT R
  END IF
END SUB

'STEP TO THE NEXT UNLOCKED MODE
SUB NEXTMODE(DR)
  FOR K=1 TO 5
    MODE=(MODE+DR+5) MOD 5
    IF MODE=0 OR (UNL AND MB(MODE)) THEN EXIT SUB
  NEXT K
END SUB

SUB WAITA
  WAIT 60
  DO
    CALL STEPSTARS
    IF BUTTON TAP(0,0) THEN EXIT
    WAIT VBL
  LOOP
END SUB

'ENDINGS: 1 NORMAL, 2 GOOD (90%
'DESTROYED), 3 TRUE (THE EYE OPENED
'AND FELL). THE EARTH WAITS BELOW
SUB ENDING(K)
  CALL RESETPLAY
  CALL DRAWBACK(1,3)
  IF K=3 THEN PALETTE 5,,16,32,48
  RESTORE ENDTXT
  FOR J=1 TO K
    READ N
    FOR I=1 TO N
      READ M$
      IF J=K THEN
        IF K=3 THEN PAL 3 ELSE PAL 6
        CALL CTEXT(9+I,M$)
        FOR F=1 TO 50
          CALL STEPSTARS
          WAIT VBL
        NEXT F
      END IF
    NEXT I
  NEXT J
  PAL 4
  CALL CTEXT(17,"TO BE CONTINUED")
  CALL WAITA
  CALL RESETPLAY
  PAL 1
  CALL CTEXT(6,"THANKS FOR PLAYING")
  PAL 6
  CALL CTEXT(8,"BY "+AUTHOR$)
  CALL WAITA
END SUB
ENDTXT:
'PLACEHOLDER UNTIL THE LAST STAGE
DATA 5,"THE FRONT","IS BROKEN.","","THE STORM WAITS","BELOW THE CLOUDS."
DATA 5,"THE FRONT","IS BROKEN.","","THE SKY CLEARS","FOR NOW."
DATA 5,"THE FRONT","IS BROKEN.","","SOMETHING STIRS","BELOW THE CLOUDS."

'PAUSE MENU IN THE HUD ROW
SUB PAUSEMENU
  STOP
  SEL=0
  QUIT=0
  OSEL=-1
  DO
    IF UP TAP(0) OR LEFT TAP(0) THEN SEL=0
    IF DOWN TAP(0) OR RIGHT TAP(0) THEN SEL=1
    IF SEL<>OSEL THEN
      OSEL=SEL
      BG 1
      BG FILL 0,0 TO 19,0 CHAR 0
      PAL 4
      IF SEL=0 THEN
        TEXT 0,0,"PAUSED >RESUME  QUIT"
      ELSE
        TEXT 0,0,"PAUSED  RESUME >QUIT"
      END IF
    END IF
    IF PAUSE THEN EXIT
    IF BUTTON TAP(0,0) THEN
      IF SEL=1 THEN QUIT=-1
      EXIT
    END IF
    WAIT VBL
  LOOP
  IF QUIT=0 THEN
    MUSIC SNG
  END IF
  CALL HUD
END SUB

'GAME OVER: 10 SECONDS TO CONTINUE.
'A CARRIES ON (SCORE RESETS), B QUITS
SUB CONTPROMPT
  STOP
  PLAY 3,40,30 SOUND 5
  FOR CD=9 TO 0 STEP -1
    BG 1
    BG FILL 0,0 TO 19,0 CHAR 0
    PAL 4
    TEXT 0,0,"CONTINUE  PRESS A"
    NUMBER 18,0,CD,1
    FOR F=1 TO 60
      IF BUTTON TAP(0,0) THEN
        INC CNT
        LIVES=3
        SC=0
        MUL=1
        CALL HUD
        PLAY 2,96,10 SOUND 4
        MUSIC SNG
        EXIT SUB
      END IF
      IF BUTTON TAP(0,1) THEN EXIT SUB
      CALL STEPSTARS
      WAIT VBL
    NEXT F
  NEXT CD
END SUB

